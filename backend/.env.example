# PostgreSQL connection used only by the separately deployed backend service.
# Hosted Supabase connections MUST include sslmode=require (or a stricter mode).
# Prefer a dedicated least-privilege login using the session pooler on port 5432;
# do not ship the postgres password or this URL in the mobile application.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:54322/postgres

# Hosted project base URL. JWKS and issuer URLs are derived from this value.
# Keep the service-role key out of this API: asymmetric JWT verification needs
# only this public project URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional overrides for non-standard/self-hosted Auth endpoints:
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256

# Generate with: openssl rand -base64 32
PINQEVA_KEY_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Independent envelope key for per-device factory bootstrap credentials.
PINQEVA_BOOTSTRAP_KEY_ENCRYPTION_KEY=replace-with-a-different-base64-encoded-32-byte-key

# Development only: the checked-in firmware bypasses bootstrap proof checks.
# Keep false for any shared or production backend.
PINQEVA_DEV_BYPASS_BOOTSTRAP_AUTH=false

# Independent HMAC root for claim capabilities and per-tag reset-control keys.
PINQEVA_CLAIM_TOKEN_KEY=replace-with-a-third-base64-encoded-32-byte-key

# Standard Base64-encoded PKCS#8 DER P-256 key. The matching public key is
# embedded in the tracker and verifies signed firmware releases only.
PINQEVA_FIRMWARE_SIGNING_PRIVATE_KEY=HERE_BASE64_PKCS8_P256_PRIVATE_KEY

# Configure both values to publish one signed BLE firmware release, or leave
# both blank to disable updates. Use an absolute path to the ESP application
# image only (not the bootloader or a merged flash image).
PINQEVA_FIRMWARE_IMAGE_PATH=
PINQEVA_FIRMWARE_VERSION=

# Provisioning window. A pending session can be claimed for longer so a temporary
# backend outage does not strand a tag after the BLE write has succeeded.
PINQEVA_SESSION_TTL_SECONDS=600
PINQEVA_CLAIM_TTL_SECONDS=86400

# Apple login/import is an explicit operator command, never API/worker startup.
# Workers use the encrypted shared session below; omit Apple ID/password from
# their deployment environment. See docs/DISTRIBUTED_ARCHITECTURE.md.
PINQEVA_FINDMY_APPLE_ID=
PINQEVA_FINDMY_APPLE_PASSWORD=
PINQEVA_FINDMY_SECOND_FACTOR=sms
PINQEVA_FINDMY_LOGIN_ON_STARTUP=false

# Local auth files are accepted only by operator import, never cloud workers.
# Direct DSID/token injection is supported for controlled deployments; rotate
# these secrets when Apple expires them.
PINQEVA_FINDMY_AUTH_FILE=
PINQEVA_FINDMY_DSID=
PINQEVA_FINDMY_SEARCH_PARTY_TOKEN=

# Cloud workers require an independently managed stable Anisette HTTP service.
# Use HTTPS for remote hosts. Each shared Apple session is pinned to the exact
# endpoint/device identity used during operator login; never randomly balance
# native device state. API replicas do not initialize Anisette.
PINQEVA_FINDMY_ANISETTE_PROVIDER=http
PINQEVA_FINDMY_ANISETTE_STATE_PATH=
PINQEVA_FINDMY_ANISETTE_URL=http://127.0.0.1:6969
PINQEVA_FINDMY_REQUEST_TIMEOUT_SECONDS=15
PINQEVA_FINDMY_LOOKBACK_HOURS=24
PINQEVA_FINDMY_REPORT_API=v2

# Operator authentication settings only. Preserve existing SMS recovery support
# without giving Apple passwords to API or location worker replicas.
PINQEVA_FINDMY_APPLE_PASSWORD_FILE=
PINQEVA_FINDMY_2FA_PROVIDER=none
PINQEVA_FINDMY_SMS_PHONE_ID=0
PINQEVA_FINDMY_TWILIO_ACCOUNT_SID=
PINQEVA_FINDMY_TWILIO_AUTH_TOKEN=
PINQEVA_FINDMY_TWILIO_AUTH_TOKEN_FILE=
PINQEVA_FINDMY_TWILIO_PHONE_NUMBER=
PINQEVA_FINDMY_TWILIO_ALLOWED_SENDERS=
PINQEVA_FINDMY_TWILIO_TIMEOUT_SECONDS=180
PINQEVA_FINDMY_TWILIO_POLL_SECONDS=3
PINQEVA_FINDMY_RETRY_INITIAL_SECONDS=60
PINQEVA_FINDMY_RETRY_MAX_SECONDS=1800
# Legacy local-state migration CLI only; distributed workers do not use files.
PINQEVA_FINDMY_STATE_PATH=state/apple-auth-state.json

# Legacy embedded-worker flags are retained for parsing compatibility only.
# Start app.worker roles explicitly; neither flag creates API background tasks.
PINQEVA_LOCATION_SYNC_WORKER_ENABLED=false
PINQEVA_NOTIFICATION_WORKER_ENABLED=false

# Shared session envelope key, independent from provisioning keys. Inject only
# into location workers and the login/import operator; generate 32 random bytes.
PINQEVA_FINDMY_SESSION_ENCRYPTION_KEY=
PINQEVA_LOCATION_ACCOUNT_KEY=default

# Shared PostgreSQL pool limits apply to EACH process. Budget total API/worker
# replicas times pool max plus one short-lived provider-child connection.
PINQEVA_DATABASE_POOL_MIN_SIZE=1
PINQEVA_DATABASE_POOL_MAX_SIZE=10
PINQEVA_DATABASE_POOL_TIMEOUT_SECONDS=5
PINQEVA_DATABASE_POOL_MAX_WAITING=100
PINQEVA_DATABASE_STATEMENT_TIMEOUT_SECONDS=30
PINQEVA_DATABASE_LOCK_TIMEOUT_SECONDS=5
PINQEVA_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Free users always read Pinkeva's last known state. Active trackers receive
# scheduled jobs spread across this interval; inactivity reduces the cadence.
PINQEVA_LOCATION_SYNC_INTERVAL_SECONDS=900
PINQEVA_LOCATION_SYNC_BATCH_SIZE=8
PINQEVA_LOCATION_INACTIVE_AFTER_DAYS=30
PINQEVA_LOCATION_INACTIVE_INTERVAL_SECONDS=21600
PINQEVA_PREMIUM_LOCATION_FRESHNESS_SECONDS=30
PINQEVA_LOCATION_REFRESH_WAIT_SECONDS=8
PINQEVA_LOCATION_JOB_TIMEOUT_SECONDS=60
PINQEVA_LOCATION_REFRESH_LEASE_SECONDS=120
PINQEVA_LOCATION_MAX_ATTEMPTS=5
PINQEVA_LOCATION_RETRY_BASE_SECONDS=30
PINQEVA_LOCATION_PREMIUM_USER_LIMIT_PER_MINUTE=30
PINQEVA_LOCATION_ACCOUNT_LIMIT_PER_MINUTE=60
PINQEVA_LOCATION_WORKER_QUEUE=all
PINQEVA_LOCATION_SCHEDULER_INTERVAL_SECONDS=60

# Health endpoints are private to the worker network. Containers expose no
# worker host port by default. Set a distinct port for processes sharing a host.
PINQEVA_WORKER_HEALTH_HOST=0.0.0.0
PINQEVA_WORKER_HEALTH_PORT=8081
PINQEVA_WORKER_SHUTDOWN_GRACE_SECONDS=75
PINQEVA_PREMIUM_RETENTION_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO

# Google Find Hub does not expose a general public report API. Configure both
# values only when an approved/isolated provider bridge is available. Loopback
# HTTP is accepted for local development; shared deployments must use HTTPS.
PINQEVA_GOOGLE_FINDHUB_BRIDGE_URL=
PINQEVA_GOOGLE_FINDHUB_BRIDGE_TOKEN=

# Stripe Billing is called only by this backend. Never use either secret in
# Expo, Xcode, Android resources, Supabase client code, or a public CI variable.
STRIPE_SECRET_KEY=sk_test_replace-with-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-endpoint-signing-secret

# The mobile app submits only a plan code. The backend resolves that code to an
# exact recurring Stripe Price and Product, preventing client-supplied IDs or
# amounts. Each pair must also match public.plan.provider_product_id, amount,
# currency, and its supported 1, 3, 6, or 12-month duration. On first startup
# these values bootstrap empty plan bindings. Later admin price changes are
# stored in the database and are never overwritten by this initial map.
STRIPE_PRICE_MAP_JSON={"monthly_basic":{"price_id":"price_REPLACE111111111","product_id":"prod_REPLACE111111111"},"quarterly_standard":{"price_id":"price_REPLACE333333333","product_id":"prod_REPLACE333333333"},"semiannual_plus":{"price_id":"price_REPLACE666666666","product_id":"prod_REPLACE666666666"},"yearly_pro":{"price_id":"price_REPLACE121212121","product_id":"prod_REPLACE121212121"}}

# Fixed HTTPS/universal-link destinations. Redirect URLs are never accepted
# from a request body or query parameter.
STRIPE_CHECKOUT_SUCCESS_URL=https://app.pinkeva.com/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://app.pinkeva.com/billing/cancelled
STRIPE_PORTAL_RETURN_URL=https://app.pinkeva.com/billing/manage/complete

# Optional dedicated Billing Portal configuration. Enable subscription updates
# only for the same Price IDs listed above.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE123456789

# Pin API and webhook endpoint behavior to the same tested Stripe version.
STRIPE_API_VERSION=2025-08-27.basil

# Renewal notifications run in app.worker maintenance (or notification).
# Expo push access tokens are optional unless push security is enabled.
PINQEVA_NOTIFICATION_POLL_INTERVAL_SECONDS=60
EXPO_PUSH_ACCESS_TOKEN=

# Admin console security. Bootstrap owners are Supabase auth user UUIDs and are
# intentionally controlled only by the deployment secret manager. Separate
# multiple values with commas. Only owners can promote/revoke database admins.
# Replace or remove the example UUID before startup; it is rejected deliberately.
PINQEVA_ADMIN_OWNER_USER_IDS=00000000-0000-4000-8000-000000000000

# Exact browser origins only; no paths, wildcards, or trailing routes.
PINQEVA_ADMIN_ALLOWED_ORIGINS=https://admin.pinkeva.com,http://127.0.0.1:5173

# Keep enabled in production. Admin data and mutations require a Supabase AAL2
# token created by a verified TOTP factor.
PINQEVA_ADMIN_REQUIRE_AAL2=true
