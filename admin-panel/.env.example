# Public browser configuration only. Never add a Supabase secret/service-role
# key, Stripe key, webhook secret, database password, or device bootstrap key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_API_URL=https://api.example.com

# Restrict this browser key in Google Cloud to the exact admin-panel origins
# and enable Maps JavaScript API only.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=replace-with-restricted-browser-key
# Optional Google Cloud Map ID.
VITE_GOOGLE_MAP_ID=
