# Public client values only. Never use a Supabase secret/service-role key,
# database password, Stripe secret, or device bootstrap key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_API_URL=https://api.example.com

# Optional Android map key. Restrict it to com.pinkeva.admin and the release
# signing certificate. iOS uses Apple Maps and does not require this key.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
