# Public client configuration only. Never place the service-role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Hosted backend URL. Plain HTTP is accepted only for loopback development.
EXPO_PUBLIC_API_URL=https://api.example.com

# Keep false until the final App Store / Play billing classification is reviewed.
EXPO_PUBLIC_ENABLE_EXTERNAL_BILLING=false

# Requires a paid Apple Developer team and the Sign in with Apple capability.
EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=false
