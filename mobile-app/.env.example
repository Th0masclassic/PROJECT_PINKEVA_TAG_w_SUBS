# Public client configuration only. Never place the service-role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Hosted backend URL. Plain HTTP is accepted only for loopback development.
EXPO_PUBLIC_API_URL=https://api.example.com

# Separate restricted Google Maps SDK keys. Restrict by iOS bundle identifier
# and Android package/SHA fingerprints in Google Cloud; do not reuse a browser key.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=replace-with-restricted-ios-key
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=replace-with-restricted-android-key
# Optional cloud-based Google map styling ID.
EXPO_PUBLIC_GOOGLE_MAP_ID=

# Requires a paid Apple Developer team and the Sign in with Apple capability.
EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=false
